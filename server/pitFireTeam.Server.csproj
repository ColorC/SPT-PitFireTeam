<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pitFireTeam.Server</AssemblyName>
    <RootNamespace>pitTeam.Server</RootNamespace>
    <Version>0.10.3</Version>
    <OutputType>Library</OutputType>
    <SptReferenceRoot Condition="'$(SptReferenceRoot)' == ''">$(MSBuildProjectDirectory)/refs/5.0.0</SptReferenceRoot>
    <SptReferenceVersion Condition="'$(SptReferenceVersion)' == ''">5.0.0.0</SptReferenceVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <Private>false</Private><HintPath>$(SptReferenceRoot)/SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <Private>false</Private><HintPath>$(SptReferenceRoot)/SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <Private>false</Private><HintPath>$(SptReferenceRoot)/SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <Private>false</Private><HintPath>$(SptReferenceRoot)/SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\" />
    <None Remove="refs\**\*" />
  </ItemGroup>
  <Target Name="ValidateSptReferences" BeforeTargets="ResolveReferences">
    <ItemGroup>
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.Common.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.DI.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SPTarkov.Server.Core.dll" />
      <RequiredSptReference Include="$(SptReferenceRoot)/SemanticVersioning.dll" />
    </ItemGroup>
    <Error
      Condition="!Exists('%(RequiredSptReference.Identity)')"
      Text="Required SPT server reference was not found: %(RequiredSptReference.Identity)"
    />
    <!-- Compile against the oldest supported SPT patch, not the installed runtime. -->
    <ItemGroup>
      <SptAssemblyReference Include="@(RequiredSptReference)" Exclude="$(SptReferenceRoot)/SemanticVersioning.dll" />
    </ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(SptAssemblyReference)">
      <Output TaskParameter="Assemblies" ItemName="SptReferenceIdentity" />
    </GetAssemblyIdentity>
    <Error
      Condition="'%(SptReferenceIdentity.Version)' != '$(SptReferenceVersion)'"
      Text="SPT compatibility requires $(SptReferenceVersion) compile references. %(SptReferenceIdentity.Identity) is %(SptReferenceIdentity.Version)."
    />
  </Target>
</Project>
