    <ItemGroup>
        <None Remove="$(ClientRuntimeRoot)\BepInEx\interop\**\*" />
        <None Remove="$(ClientRuntimeRoot)\BepInEx\interop\**\*" />
        <None Include=".editorconfig" />
    </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <Private>false</Private><HintPath>$(ClientRuntimeRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <Private>false</Private><HintPath>$(ClientRuntimeRoot)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <Private>false</Private><HintPath>$(ClientRuntimeRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
    </Reference>
  </ItemGroup>
    <Target Name="ValidateSptClientReferences" BeforeTargets="ResolveReferences">
        <!-- These are the SPT libraries called by the core plugin. Use the extracted SPT 5.0 client libraries. -->
        <ItemGroup>
            <SptClientReference Include="$(ClientRuntimeRoot)\BepInEx\plugins\sptushonka\SPTushonka.Common.dll" />
            <SptClientReference Include="$(ClientRuntimeRoot)\BepInEx\plugins\sptushonka\SPTushonka.Reflection.dll" />
        </ItemGroup>
        <Error Condition="!Exists('%(SptClientReference.Identity)')"
               Text="Required SPT 5.0.0 client reference was not found: %(SptClientReference.Identity)" />
        <GetAssemblyIdentity AssemblyFiles="@(SptClientReference)">
            <Output TaskParameter="Assemblies" ItemName="SptClientReferenceIdentity" />
        </GetAssemblyIdentity>
        <Error Condition="'%(SptClientReferenceIdentity.Version)' != '5.0.0.0'"
               Text="SPT 5.0 compatibility requires 5.0.0.0 compile references. %(SptClientReferenceIdentity.Identity) is %(SptClientReferenceIdentity.Version)." />
    </Target>

    <Target Name="BuildSAINAddon" AfterTargets="Build" Condition="'$(BuildSAINAddon)' != 'false' and '$(IsBuildingSAINAddon)' != 'true'">
        <MSBuild Projects="..\addon\pitFireTeam.SAINAddon.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);Platform=$(Platform);BuildProjectReferences=false;IsBuildingSAINAddon=true;OutDir=$(OutDir)" />
    </Target>

  <Target Name="VerifySpt5InteropContracts" AfterTargets="Build"
          Condition="'$(SkipSpt5Contracts)' != 'true' and '$(IsBuildingSAINAddon)' != 'true'">
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tests\Check-Spt5Build.ps1&quot; -ModDll &quot;$(TargetPath)&quot; -ClientRuntimeRoot &quot;$(ClientRuntimeRoot)&quot; -ModKind pitFireTeam" />
  </Target>
</Project>
